{
  "name": "stockpilot",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "dev": "cd apps/web && next dev --turbo",
    "postinstall": "npx prisma generate --schema apps/web/prisma/schema.prisma",
    "build": "npx prisma generate --schema apps/web/prisma/schema.prisma && cd apps/web && next build",
    "start": "cd apps/web && next start",
    "lint": "cd apps/web && eslint .",
    "typecheck": "tsc --noEmit --project apps/web/tsconfig.json",
    "prisma": "prisma",
    "audit:docs": "tsx scripts/audit/feature-doc-audit.ts",
    "docs:sync": "tsx scripts/audit/generate-maturity-matrix.ts",
    "prisma:generate": "prisma generate --schema apps/web/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/web/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema apps/web/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema apps/web/prisma/schema.prisma",
    "script:check-all-data": "tsx apps/web/scripts/check-all-data.ts",
    "script:check-demo-data": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/check-demo-data.ts",
    "script:delete-all-data": "tsx apps/web/scripts/delete-all-data.ts",
    "script:delete-all-suppliers": "tsx apps/web/scripts/delete-all-suppliers.ts",
    "script:delete-all-categories": "tsx apps/web/scripts/delete-all-categories.ts",
    "script:delete-user": "tsx apps/web/scripts/delete-user.ts",
    "script:backfill-order-stock": "tsx apps/web/scripts/backfill-order-stock.ts",
    "script:check-order-stock": "tsx apps/web/scripts/check-order-product-stock.ts",
    "script:fix-product2-stock": "tsx apps/web/scripts/fix-product2-stock.ts",
    "script:normalize-qty": "tsx apps/web/scripts/normalize-quantity-types.ts",
    "script:normalize-money": "tsx apps/web/scripts/normalize-money.ts",
    "seed": "tsx apps/web/scripts/seed/seed.ts",
    "test:phase1": "tsx apps/web/scripts/tests/phase1-stock-truth-invariants.ts",
    "test:phase2": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase2-workspace-invariants.ts",
    "test:phase3": "tsx apps/web/scripts/tests/phase3-invariants.ts && tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase3-procurement-invariants.ts",
    "test:phase4": "tsx apps/web/scripts/tests/phase4-design-system.ts && tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase4-fulfillment-invariants.ts",
    "test:phase5": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase5-action-center-invariants.ts && tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase5-auth-invariants.ts && tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase5-auth-runtime.ts && tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase5-login-matrix.ts",
    "test:phase6": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase6-web-shell-invariants.ts && tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase6-replenishment-invariants.ts",
    "test:phase35": "tsx apps/web/scripts/tests/phase35-webhook-invariants.ts",
    "test:phase65": "tsx apps/mobile/scripts/tests/phase65-mobile-invariants.ts",
    "test:phase7": "tsx apps/web/scripts/tests/phase7-product-invariants.ts && tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase7-tax-gst-invariants.ts",
    "test:phase8": "tsx apps/web/scripts/tests/phase8-warehouse-invariants.ts",
    "test:phase11": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase11-supplier-marketplace.ts",
    "test:phase115": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase115-ai-engine.ts",
    "test:phase12": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase12-forecasting.ts",
    "test:phase9": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase9-order-invoice-invariants.ts",
    "test:phase10": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase10-payment-shipping-invariants.ts",
    "test:phase11": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase11-supplier-marketplace.ts",
    "test:phase115": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase115-ai-engine.ts",
    "test:phase12": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase12-forecasting.ts",
    "test:phase13": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase13-notification-support-invariants.ts",
    "test:phase14": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase14-control-center-invariants.ts",
    "test:phase15": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase15-testing-invariants.ts",
    "test:phase16": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase16-security-invariants.ts",
    "test:phase17": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase17-performance-invariants.ts",
    "test:phase18": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase18-observability-invariants.ts",
    "test:phase19": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase19-deploy-invariants.ts",
    "test:phase20": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/tests/phase20-final-verify-invariants.ts",
    "verify:all": "npm run typecheck && npm run lint && npm run audit:docs && npm run test:phase2 && npm run test:phase3 && npm run test:phase35 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase65 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11 && npm run test:phase115 && npm run test:phase12 && npm run test:phase13 && npm run test:phase14 && npm run test:phase15 && npm run test:phase16 && npm run test:phase17 && npm run test:phase18 && npm run test:phase19 && npm run test:phase20 && npm run openapi:check && npm run seed && npm run build",
    "outbox:worker": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/outbox-worker.ts",
    "generate:pwa-icons": "tsx apps/web/scripts/generate-pwa-icons.ts",
    "openapi:check": "tsx apps/web/scripts/check-openapi.ts",
    "openapi:update": "tsx apps/web/scripts/check-openapi.ts --update"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@imagekit/nodejs": "^7.3.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.34.0",
    "@stripe/stripe-js": "^8.7.0",
    "@tanstack/query-sync-storage-persister": "^5.90.19",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-query-persist-client": "^5.90.19",
    "@tanstack/react-table": "^8.20.5",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@upstash/qstash": "^2.8.4",
    "@upstash/redis": "^1.36.1",
    "autoprefixer": "^10.4.20",
    "axios": "^1.8.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.562.0",
    "mongodb": "^4.17.2",
    "next": "^16.0.0",
    "next-themes": "^0.4.3",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.53.2",
    "react-icons": "^5.3.0",
    "react-number-format": "^5.4.2",
    "recharts": "^3.1.2",
    "shippo": "^2.17.4",
    "stripe": "^20.3.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/exceljs": "^0.5.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.5.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "glob": ">=11.0.0",
    "rimraf": "^5.0.5"
  }
}
